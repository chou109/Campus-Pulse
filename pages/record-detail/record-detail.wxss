.detail-page { padding-top:28rpx; }.detail-hero { margin-top:30rpx; background:#dfe8d7; }.detail-distance { font-size:78rpx; font-weight:800; }.detail-distance text { font-size:24rpx; font-weight:400; }.detail-metrics { border-top:1rpx solid rgba(31,42,36,.12); margin-top:25rpx; padding-top:22rpx; justify-content:space-between; }.detail-metrics > view { display:flex; flex-direction:column; gap:5rpx; }.detail-metrics .metric { font-size:30rpx; }.detail-map { margin-top:20rpx; padding:0; overflow:hidden; height:420rpx; }.detail-map map { width:100%; height:100%; }.route-empty { margin-top:20rpx; display:flex; flex-direction:column; align-items:center; gap:10rpx; padding:60rpx 20rpx; }.detail-actions { margin-top:24rpx; display:flex; flex-direction:column; gap:14rpx; }.delete-detail { border:0; background:transparent; color:#c76543; height:70rpx; line-height:70rpx; font-size:23rpx; }

.share-detail { background:#ecf0e8; color:#1f2a24; border-radius:18rpx; height:76rpx; line-height:76rpx; font-weight:700; font-size:24rpx; }

.share-preview { margin-top:22rpx; display:flex; flex-direction:column; gap:12rpx; background:#f0e7d9; }.preview-brand { color:#a05c35; font-size:19rpx; font-weight:800; letter-spacing:2rpx; }.preview-distance { font-size:64rpx; font-weight:800; color:#28362c; }.preview-caption { font-size:23rpx; color:#5f7162; }.preview-privacy { font-size:19rpx; color:#8b8f87; }.disabled-share { opacity:.55; }

.ai-review { margin-top:22rpx; display:flex; flex-direction:column; gap:18rpx; background:#f4efe7; }.ai-title { display:block; font-size:29rpx; font-weight:800; }.ai-subtitle { display:block; margin-top:6rpx; }.ai-source { color:#607c59; font-size:19rpx; }.ai-button { border:0; background:#1f2a24; color:#fff; height:72rpx; line-height:72rpx; border-radius:16rpx; font-size:23rpx; }.ai-result { display:flex; flex-direction:column; gap:16rpx; line-height:1.6; font-size:22rpx; }.ai-result > view { display:flex; flex-direction:column; gap:6rpx; }.ai-label { color:#a05c35; font-size:19rpx; font-weight:800; }.ai-disclaimer,.ai-error { color:#8d7569; font-size:19rpx; line-height:1.5; }.ai-error { color:#bd553c; }
