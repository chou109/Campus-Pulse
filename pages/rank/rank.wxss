.tabs { display:flex; background:#e9eee7; border-radius:16rpx; padding:6rpx; margin:32rpx 0 20rpx; }.tab { flex:1; text-align:center; padding:16rpx; color:#879188; font-size:24rpx; }.tab.active { background:#fff; border-radius:12rpx; color:#1f2a24; font-weight:700; }.podium { height:310rpx; display:flex; justify-content:space-around; align-items:flex-end; padding:30rpx 20rpx; }.pod { display:flex; flex-direction:column; align-items:center; gap:8rpx; font-size:22rpx; }.first { margin-bottom:30rpx; }.pod-avatar { width:76rpx;height:76rpx;border-radius:50%;background:#dfe8d7;color:#587052;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:30rpx; }.gold { background:#f5ddae; color:#a06f21; }.crown { color:#df8933; font-size:30rpx; }.pod-km { color:#e36b3d; font-size:20rpx; }.list { padding: 8rpx 24rpx; }.rank-row { display:flex;align-items:center;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #edf0eb; }.rank-row:last-child { border:0; }.rank-row.me { background:#f8eee6;margin:0 -24rpx;padding-left:24rpx;padding-right:24rpx; }.rank-no { width:30rpx;color:#a0aaa1;text-align:center; }.list-avatar { width:62rpx;height:62rpx;border-radius:50%;background:#e8ece5;color:#607160;display:flex;align-items:center;justify-content:center;font-weight:700; }.rank-info { flex:1;display:flex;flex-direction:column;gap:4rpx; }.km { color:#27372b;font-weight:800; }.km text { color:#8d968f;font-weight:400;font-size:20rpx; }

.privacy-hint { margin-top:18rpx; color:#a5684d; background:#fff0e8; border-radius:14rpx; padding:14rpx 18rpx; font-size:21rpx; }
