<view class="container">
  <view class="row between">
    <view><view class="eyebrow">CAMPUS / MOVE</view><view class="title">嗨，{{user.name}}<text style="color:#e36b3d">。</text></view><view class="muted">今天也为自己积攒一点能量</view></view>
    <view class="avatar">{{user.avatarText}}</view>
  </view>
  <view class="hero card">
    <view class="row between"><view><view class="muted">本周运动里程</view><view class="hero-num">{{weeklyDistance}}<text> km</text></view></view><view class="hero-badge">↗ 进步 18%</view></view>
    <view class="mini-line"><view style="width:{{weekProgress}}%"></view></view>
    <view class="row between"><text class="muted small">距离周目标 10 km</text><text class="muted small">还差 {{remainingDistance}} km</text></view>
  </view>
  <view class="quick-grid">
    <view class="quick card" bindtap="startRun"><view class="quick-icon coral">▶</view><text>开始运动</text><text class="muted small">记录今天的步伐</text></view>
    <view class="quick card" bindtap="openChallenges"><view class="quick-icon green">✦</view><text>加入挑战</text><text class="muted small">和同学一起坚持</text></view>
  </view>
  <view class="row between section-title"><text>本周趋势</text><text class="muted small">{{totalDistance}} km 累计</text></view>
  <view class="chart card"><view class="bars"><block wx:for="{{bars}}" wx:key="index"><view class="bar-col"><view class="bar" style="height:{{item}}%"></view><text>{{days[index]}}</text></view></block></view></view>
  <view class="row between section-title"><text>最近动态</text><text class="muted small" bindtap="openRank">查看榜单 ›</text></view>
  <view class="card activity" wx:if="{{hasRecords}}"><block wx:for="{{feed}}" wx:key="date"><view class="row activity-row"><view class="activity-dot">跑</view><view class="activity-main"><text>完成一次跑步</text><text class="muted small">{{item.date}} · {{item.distance}} km · {{item.pace}} /km</text></view><text class="pill">+{{item.calories}} kcal</text></view></block></view>
  <view class="card empty" wx:else>还没有运动记录，去完成第一次打卡吧。</view>
</view>
