<view class="container">
  <view wx:if="{{showOnboarding}}" class="onboarding-mask"><view class="onboarding-card"><text class="onboarding-kicker">WELCOME TO CAMPUS PULSE</text><text class="onboarding-title">让每一步都有回应</text><text class="onboarding-copy">先用演示模式体验记录、榜单、挑战和勋章。真实定位只在你主动授权后启用。</text><button class="primary-btn" bindtap="closeOnboarding">开始探索</button></view></view>
  <view class="row between">
    <view><view class="eyebrow">CAMPUS / MOVE</view><view class="title">嗨，{{user.name}}<text style="color:#e36b3d">。</text></view><view class="muted">今天也为自己积攒一点能量</view></view>
    <view class="avatar">{{user.avatarText}}</view>
  </view>
  <view class="hero card">
    <view class="row between"><view><view class="muted">本周运动里程</view><view class="hero-num">{{weeklyDistance}}<text> km</text></view></view><view class="hero-badge">{{changeText}}</view></view>
    <view class="mini-line"><view style="width:{{weekProgress}}%"></view></view>
    <view class="row between"><text class="muted small">距离周目标 {{weeklyGoalKm}} km</text><text class="muted small">{{weekProgress >= 100 ? '目标已完成' : '还差 ' + remainingDistance + ' km'}}</text></view>
  </view>
  <view wx:if="{{announcement}}" class="announcement-card card"><text class="announcement-label">校园公告</text><text class="announcement-title">{{announcement.title}}</text><text class="announcement-body">{{announcement.body}}</text></view>
  <view class="quick-grid">
    <view class="quick card" bindtap="startRun"><view class="quick-icon coral">▶</view><text>开始运动</text><text class="muted small">记录今天的步伐</text></view>
    <view class="quick card" bindtap="openChallenges"><view class="quick-icon green">✦</view><text>加入挑战</text><text class="muted small">和同学一起坚持</text></view>
  </view>
  <view class="row between section-title"><text>{{trendTitle}}</text><text class="muted small">{{trendTotal}} km</text></view>
  <view class="trend-tabs"><view class="trend-tab {{trendMode==='week'?'selected':''}}" data-mode="week" bindtap="selectTrend">周</view><view class="trend-tab {{trendMode==='month'?'selected':''}}" data-mode="month" bindtap="selectTrend">月</view></view>
  <view class="chart card"><view wx:if="{{!trendEmpty}}" class="bars"><block wx:for="{{chartBars}}" wx:key="label"><view class="bar-col"><view class="bar" style="height:{{item.heightText}}"></view><text>{{item.label}}</text></view></block></view><view wx:else class="chart-empty">这段时间还没有运动记录</view></view>
  <view class="row between section-title"><text>最近动态</text><text class="muted small" bindtap="openRecords">查看全部 ›</text></view>
  <view class="card activity" wx:if="{{hasRecords}}"><block wx:for="{{feed}}" wx:key="id"><view class="row activity-row"><view class="activity-dot">跑</view><view class="activity-main"><text>完成一次跑步</text><text class="muted small">{{item.date}} · {{item.distanceText}} km · {{item.pace}} /km · {{item.visibilityText}}</text></view><text class="pill">+{{item.calories}} kcal</text></view></block></view>
  <view class="card empty" wx:else>还没有运动记录，去完成第一次打卡吧。</view>
</view>
