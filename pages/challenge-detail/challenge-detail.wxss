.challenge-detail-page { padding-top:28rpx; }.detail-banner { height:230rpx; border-radius:28rpx; margin:26rpx 0; padding:28rpx; display:flex; align-items:flex-end; justify-content:space-between; box-sizing:border-box; }.detail-banner.orange { background:#fae0d3; color:#bb6541; }.detail-banner.blue { background:#dceaf1; color:#477b91; }.detail-banner.purple { background:#e8e0ef; color:#77558d; }.detail-symbol { font-size:100rpx; line-height:1; }.detail-badge { border-radius:999rpx; padding:10rpx 16rpx; background:rgba(255,255,255,.65); font-size:22rpx; }.detail-stats { display:flex; justify-content:space-around; text-align:center; margin-top:26rpx; }.detail-stats > view { display:flex; flex-direction:column; gap:8rpx; }.detail-stat { font-size:27rpx; font-weight:800; }.progress-card { display:flex; flex-direction:column; gap:18rpx; }.progress-number { color:#e36b3d; font-weight:800; }.rules { display:flex; flex-direction:column; gap:20rpx; line-height:1.7; }.detail-actions { margin-top:26rpx; display:flex; flex-direction:column; gap:14rpx; }.share-detail { background:#ecf0e8; color:#1f2a24; border-radius:18rpx; height:76rpx; line-height:76rpx; font-weight:700; font-size:24rpx; }
