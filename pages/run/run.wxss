.run-page { padding-top:28rpx; }.mode-hint { margin: 18rpx 0; font-size:22rpx; }.map-card { height:420rpx; overflow:hidden; border-radius:30rpx; margin:24rpx 0; background:#dfe8d7; }.map-card map { width:100%; height:100%; }.run-metrics { padding:32rpx; }.main-metric { display:flex; align-items:baseline; margin-bottom:28rpx; }.main-metric .metric { font-size:94rpx; }.metric-unit { margin-left:10rpx; color:#8d968f; }.metric-grid { border-top:1rpx solid #edf0eb; padding-top:26rpx; justify-content:space-between; }.metric-grid > view { display:flex; flex-direction:column; gap:6rpx; }.small-metric { font-size:34rpx; }.run-actions { display:flex; flex-direction:column; gap:14rpx; margin-top:24rpx; }.finish-btn { border:0; color:#e36b3d; background:transparent; height:76rpx; line-height:76rpx; }.safety-note { display:flex; gap:14rpx; margin-top:24rpx; color:#7d877f; font-size:22rpx; line-height:1.6; }.note-icon { flex:none; width:36rpx; height:36rpx; border-radius:50%; background:#edf0eb; color:#657567; display:flex; align-items:center; justify-content:center; }
.safety-note > view { display:flex; flex-direction:column; gap:8rpx; flex:1; }.safety-copy { color:#7d877f; }
