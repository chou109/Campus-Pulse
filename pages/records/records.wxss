.records-page { padding-top:28rpx; }.reset-btn { margin:0; padding:0 18rpx; height:62rpx; line-height:62rpx; border-radius:14rpx; background:#edf0eb; color:#5f7162; font-size:21rpx; }.record-list { margin-top:32rpx; }.record-card { position:relative; margin-bottom:18rpx; padding:28rpx; }.record-date { font-size:30rpx; font-weight:800; display:block; }.record-source { display:inline-block; color:#9aa39c; font-size:20rpx; margin-top:8rpx; }.record-distance { color:#df6d42; font-size:42rpx; font-weight:800; }.record-distance text { color:#9aa39c; font-size:20rpx; font-weight:400; }.record-meta { border-top:1rpx solid #edf0eb; margin-top:22rpx; padding-top:18rpx; color:#7f8981; font-size:21rpx; gap:20rpx; }.record-delete { margin:18rpx 0 0 auto; padding:0 16rpx; height:52rpx; line-height:52rpx; font-size:20rpx; color:#c76543; background:#fff0eb; border:0; border-radius:12rpx; }.empty-records { margin-top:40rpx; display:flex; flex-direction:column; align-items:center; gap:12rpx; padding:70rpx 30rpx; }.empty-icon { font-size:70rpx; color:#c6cec5; }
